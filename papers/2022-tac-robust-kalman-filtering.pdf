      <rdf:Description rdf:about=""
            xmlns:pdf="http://ns.adobe.com/pdf/1.3/">
         <pdf:Keywords>Kalman filtering; Uncertain systems; Estimation; Optimization; Relative entropy constraint</pdf:Keywords>
         <pdf:Producer>PDFlib+PDI 8.0.1p8 (Perl 5.10.0/Linux-x86_64)</pdf:Producer>
